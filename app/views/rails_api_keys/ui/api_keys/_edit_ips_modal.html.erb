<div data-modal-target="modal"
     data-action="keydown@window->modal#closeOnEscape"
     class="hidden fixed inset-0 z-50 overflow-y-auto">
  <div class="flex items-center justify-center min-h-screen px-4">
    <div data-modal-target="backdrop"
         data-action="click->modal#closeOnBackdropClick"
         class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity"></div>
    <div data-modal-target="panel"
         class="relative bg-white rounded-lg shadow-xl max-w-md w-full p-6 z-10">
      <div class="flex justify-between items-center mb-4">
        <h3 class="text-lg font-medium text-gray-900"><%= t("rails_api_keys_ui.api_keys.edit_ips_title", name: api_key.name) %></h3>
        <button type="button"
                data-action="click->modal#close"
                class="text-gray-400 hover:text-gray-500">
          ×
        </button>
      </div>
      <%= form_with url: update_path, scope: :api_key, method: :patch, class: "space-y-4" do |f| %>
        <div>
          <%= f.label :allowed_ips, t("rails_api_keys_ui.api_keys.form.allowed_ips"), for: "api_key_allowed_ips_#{api_key.id}", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.text_area :allowed_ips,
                          id: "api_key_allowed_ips_#{api_key.id}",
                          value: api_key.allowed_ips.join("\n"),
                          rows: 3,
                          class: "form-input w-full border-gray-300 rounded-md shadow-sm font-mono",
                          placeholder: t("rails_api_keys_ui.api_keys.form.allowed_ips_placeholder") %>
          <p class="mt-1 text-xs text-gray-500"><%= t("rails_api_keys_ui.api_keys.form.allowed_ips_hint") %></p>
        </div>
        <div class="flex justify-end space-x-3 pt-4">
          <button type="button"
                  data-action="click->modal#close"
                  class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
            <%= t("rails_api_keys_ui.api_keys.cancel") %>
          </button>
          <%= f.submit t("rails_api_keys_ui.api_keys.save"),
                       class: "inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-primary-600 hover:bg-primary-700 cursor-pointer" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
